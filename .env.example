# ── LLM (Required) ────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com  (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
# Name of the freedom fighter to generate video for
FREEDOM_FIGHTER_NAME=Bhagat Singh

# TTS provider: "gtts" 
TTS_PROVIDER=gtts

# Image provider: "pollinations"
IMAGE_PROVIDER=pollinations

# LLM provider: "groq"
LLM_PROVIDER=groq

# Number of images to generate (more = smoother video)
IMAGE_COUNT=5

# Output video resolution: "720p" | "480p" | "1080p"
VIDEO_RESOLUTION=720p
