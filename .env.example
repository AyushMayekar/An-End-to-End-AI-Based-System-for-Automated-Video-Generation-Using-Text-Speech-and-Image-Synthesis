# ── LLM (Required) ────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com  (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# ── TTS Provider (Optional — gTTS works without any key) ──────────────────────
# Get free key at: https://elevenlabs.io (10,000 chars/month free)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Image Generation (Optional — Pollinations.ai needs no key) ────────────────
# Get free key at: https://platform.stability.ai
STABILITY_API_KEY=your_stability_api_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
# Name of the freedom fighter to generate video for
FREEDOM_FIGHTER_NAME=Bhagat Singh

# TTS provider: "gtts" | "edge_tts" | "elevenlabs"
TTS_PROVIDER=gtts

# Image provider: "pollinations" | "stability" | "huggingface"
IMAGE_PROVIDER=pollinations

# LLM provider: "groq"
LLM_PROVIDER=groq

# Target video duration in seconds
VIDEO_DURATION=10

# Number of images to generate (more = smoother video)
IMAGE_COUNT=5

# Output video resolution: "720p" | "480p" | "1080p"
VIDEO_RESOLUTION=720p
